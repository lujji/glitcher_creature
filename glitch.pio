.pio_version 0

.program glitch
read_edges:
    set     pins, 0
    pull    block
    mov     y, osr

read_delay:
    pull    block
    mov     x, osr

read_pattern:
    pull    block

public trigger:
    wait    0 pin 0         // trigger on rising edge
    wait    1 pin 0
    jmp     y--, trigger

public delay:
    jmp     x--, delay

    mov     x, osr
loop:
    set     pins, 1
    jmp     x--, loop
    set     pins, 0
    jmp     read_edges


.program glitch_pattern
read_edges:
    set     pins, 0
    pull    block
    mov     y, osr

read_delay:
    pull    block
    mov     x, osr

read_pattern:
    pull    block

public trigger:
    wait    0 pin 0         // trigger on rising edge
    wait    1 pin 0
    jmp     y--, trigger

public delay:
    jmp     x--, delay

loop:
    out     pins, 1
    jmp     !osre, loop
    jmp     read_edges

% c-sdk {
static inline void glitch_program_init(PIO pio, uint sm, uint offset, uint glitch_out, uint trigger_in, bool pattern, bool rising_edge) {
    pio_gpio_init(pio, glitch_out);
    pio_sm_set_consecutive_pindirs(pio, sm, glitch_out, 1, true);
    pio_sm_set_consecutive_pindirs(pio, sm, trigger_in, 1, false);
    gpio_set_pulls(trigger_in, 0, 0);
    gpio_set_drive_strength(glitch_out, GPIO_DRIVE_STRENGTH_12MA);
    gpio_set_slew_rate(glitch_out, GPIO_SLEW_RATE_FAST);

    pio_sm_config c;
    if (pattern) {
        c = glitch_pattern_program_get_default_config(offset);
        if (!rising_edge) {
            pio->instr_mem[offset + glitch_pattern_offset_trigger] = pio_encode_wait_pin(true, 0);
            pio->instr_mem[offset + glitch_pattern_offset_trigger + 1] = pio_encode_wait_pin(false, 0);
        }
    } else {
        c = glitch_program_get_default_config(offset);
        if (!rising_edge) {
            pio->instr_mem[offset + glitch_offset_trigger] = pio_encode_wait_pin(true, 0);
            pio->instr_mem[offset + glitch_offset_trigger + 1] = pio_encode_wait_pin(false, 0);
        }
    }

    sm_config_set_in_pins(&c, trigger_in);
    sm_config_set_out_pins(&c, glitch_out, 1);
    sm_config_set_set_pins(&c, glitch_out, 1);

    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}
